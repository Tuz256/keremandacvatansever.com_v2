---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  link?: string;
  tags?: string[];
  emoji?: string;
  image?: ImageMetadata;
  color?: string;
  delay?: number;
}

const {
  title,
  description,
  link,
  tags = [],
  emoji,
  image,
  color,
  delay = 0,
} = Astro.props;

const hasImage = Boolean(image);
---

<a
  href={link || "#"}
  target="_self"
  rel="noopener noreferrer"
  class="card"
  style={`--delay: ${delay}s;`}
>
  <div class={hasImage ? "two-column" : "card-header"}>
    <div class="content">
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </div>

    {
      image && (
        <div
          class="image-wrapper"
          style={color ? `background-color: ${color};` : ""}
        >
          <Image
            src={image}
            alt={title}
            width={1800}
            height={1000}
            quality={90}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    {
      !image && emoji && (
        <div
          class="emoji-wrapper"
          style={color ? `background-color: ${color};` : ""}
        >
          {emoji}
        </div>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    position: relative;
    display: block;
    text-decoration: none;
    background: rgba(24, 24, 34, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.1rem;
    cursor: pointer;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    animation-delay: var(--delay);
    will-change: transform;
  }

  .card:hover {
    transform: scale(1.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    z-index: 2;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .two-column {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .content {
    flex: 1;
  }

  h3 {
    color: #fff;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  p {
    color: rgba(255, 255, 255, 0.6);
    /* font-size: 0.9rem; */
    margin-bottom: 1rem;
    text-align: left;
  }

  .emoji-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    margin-bottom: 0.75rem;
    margin-left: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .image-wrapper {
    width: 100%;
    max-width: 200px;
    aspect-ratio: 3 / 2;
    height: auto;
    border-radius: 10px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.25rem 0.6rem;
    background: #c300ff14;
    border: 1px solid #7fffd426;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: #fff;
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .image-wrapper {
      width: 165px;
      height: 110px;
    }
  }
</style>
