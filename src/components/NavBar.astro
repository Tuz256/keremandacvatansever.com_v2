---
// Navigation link for external pages internal page sections
const OTHER_PAGE_LINKS = [{ label: "TARİFLER", id: "Recipes", href: "/recipes" }];

// Navigation link for in-page sections
const INPAGE_LINKS = [
  { label: "HAKKIMDA", id: "About" },
  { label: "PROJELER", id: "Projects" },
];

const { current = "Default current" } = Astro.props;
---

<nav id="navbar">
  <!-- Left Logo-->
  <a href="/" id="logo-link">
    <span class="logo-text">
      KA<span class="brand-dot">.</span>
    </span>
  </a>

  <!-- Center Other Page Links (only in desktop) -->
  <div class="page-nav">
    {
      OTHER_PAGE_LINKS.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { active: current === item.id }]}
        >
          {item.label}
          <span class="underline" />
        </a>
      ))
    }
  </div>

  <!-- Right In-Page Sections Links (if in home page) -->
  {
    current === "Home" && (
      <div class="desktop-nav">
        {INPAGE_LINKS.map((item) => (
          <a href={`#${item.id}`} class="nav-link" data-section={item.id}>
            {item.label}
            <span class="underline" />
          </a>
        ))}
      </div>
    )
  }

  <!-- Hamburger Menu Button (only in mobile) -->
  <button id="menu-btn" class="mobile-menu-btn" aria-label="Menüyü Aç/Kapat">
    <span class="icon-bar">☰</span>
  </button>

  <!-- Dropdown Navigation Menu (only in mobile) -->
  <div id="mobile-menu" class="mobile-menu hidden">
    {
      // In-Page Sections Links (if in home page)
      current === "Home" && (
          <div class="mobile-sections">
            {INPAGE_LINKS.map((link) => (
              <a
                href={`#${link.id}`}
                class="mobile-nav-link"
                data-section={link.id}
              >
                {link.label}
              </a>
            ))}
          </div>

          <div class="mobile-divider" />

      )
    }

    <!-- Other Page Links (only in home page) -->
    <div class="mobile-pages">
      {
        OTHER_PAGE_LINKS.map((item) => (
          <a
            href={item.href}
            class:list={["mobile-nav-link", { active: current === item.id }]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  // DOM element selections
  const navbar = document.getElementById("navbar");
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const logoLink = document.getElementById("logo-link");
  const iconBar = menuBtn?.querySelector(".icon-bar");
  const navLinks = document.querySelectorAll("[data-section]");

  // Update navbar styling and highlight active section links
  const onScroll = () => {
    // Add backdrop when scrolled more than threshold
    if (window.scrollY > 40) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }

    const scrollPosition = window.scrollY + 250;

    // Detect which section is currently in viewport and update active state
    navLinks.forEach((link) => {
      const sectionId = link.getAttribute("data-section");
      if (!sectionId) return;

      const section = document.getElementById(sectionId);
      if (!section) return;

      const sectionTop = section.offsetTop;
      const sectionBottom = sectionTop + section.offsetHeight;

      if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
        link.classList.add("active");
      } else {
        link.classList.remove("active");
      }
    });
  };

  // Attach scroll event listener
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Toggle mobile menu visibility and icon state
  menuBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.toggle("hidden");
    if (iconBar) {
      iconBar.textContent = isHidden ? "☰" : "✕";
    }
  });

  // Enable smooth scrolling for section links and close mobile menu on click
  navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const targetId = link.getAttribute("data-section");
      const targetSection = targetId ? document.getElementById(targetId) : null;

      if (targetSection) {
        targetSection.scrollIntoView({ behavior: "smooth" });
      }

      // Close mobile menu if open
      if (!mobileMenu?.classList.contains("hidden")) {
        mobileMenu?.classList.add("hidden");
        if (iconBar) iconBar.textContent = "☰";
      }
    });
  });

  // Scroll smoothly to top when logo is clicked while already on the home page
  logoLink?.addEventListener("click", (e) => {
    if (
      window.location.pathname === "/" ||
      window.location.pathname === "/index.html"
    ) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });
</script>

<style>

  button {
    color: var(--color-button);
  }

  a {
    color: var(--color-text);
  }

  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    padding: 0 2rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: transparent;
    backdrop-filter: none;
    transition: all 0.35s ease;
  }

  nav.scrolled {
    background: var(--color-bg-navbar);
    backdrop-filter: blur(12px);
  }

  .page-nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);

    display: flex;
    align-items: center;
  }

  .page-nav .nav-link.active .underline {
    animation: underlineIn 0.3s ease forwards;
  }

  #logo-link {
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .brand-dot {
    color: var(--color-brand);
  }

  .desktop-nav {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s;
    padding: 0.25rem 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-brand);
  }

  .nav-link.active .underline {
    animation: underlineIn 0.3s ease forwards;
  }

  .underline {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: center;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
  }

  .mobile-menu {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: #0a0a0ef7;
    backdrop-filter: blur(12px);
    padding: 1.5rem;
  }

  .mobile-menu.hidden {
    display: none;
  }

  .mobile-sections,
  .mobile-pages {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-divider {
    width: 80%;
    height: 1px;
    margin: 1.5rem auto;
    background: rgba(255, 255, 255, 0.2);
  }

  .mobile-nav-link {
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1rem;
    text-align: left;
  }

  .mobile-nav-link.active {
    color: var(--color-brand);
  }

  @keyframes underlineIn {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 640px) {
    .desktop-nav {
      display: none !important;
    }

    .page-nav {
      display: none !important;
    }

    .mobile-menu-btn {
      display: block !important;
    }
  }
</style>
