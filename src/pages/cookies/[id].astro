---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import Drawer from "../../components/Drawer.astro";

export async function getStaticPaths() {
  const cookies = await getCollection("cookies");
  return cookies.map((cookie: CollectionEntry<"cookies">) => ({
    params: { id: cookie.id },
    props: { cookie },
  }));
}

interface Props {
  cookie: CollectionEntry<"cookies">;
}

const { cookie } = Astro.props;
const { Content } = await render(cookie);
---

<MainLayout
  title={cookie.data.title + " - KA."}
  description={cookie.data.description}
  current="Recipes"
>
  <div class="Main">
    <section id="Recipe">
      <article class="recipe-container">
        <div class="hero-wrapper" id="heroWrapper">
          <div class="left">
            <div class="title-wrapper">
              <h1 class="title">{cookie.data.title}</h1>
              <p>{cookie.data.description}</p>
            </div>
            <Image
              src={cookie.data.image}
              alt={cookie.data.title}
              class="hero-image"
              width={1440}
              height={900}
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <div class="right">
            <div class="ingredients-wrapper">
              <h2>Malzemeler</h2>
              <ul class="ingredients">
                {cookie.data.ingredients.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <section class="instructions">
          <Content />
        </section>
      </article>
    </section>

    <Drawer ingredients={cookie.data.ingredients} />
    <ScrollToTop position="Left" bottom="55px" />
  </div>
</MainLayout>

<style>
  body {
    font-size: clamp(1rem, 1.1vw, 2rem);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  section {
    padding: 5rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    width: 100%;
    overflow-x: hidden;
  }

  h1,
  h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  p {
    margin: 0;
  }

  .recipe-container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-wrapper {
    display: flex;
    gap: 1rem;
    width: 100%;
    margin-bottom: 6rem;
  }

  .left {
    flex: 3;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .right {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 10px;
  }

  .title-wrapper {
    padding: 1.25rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #fff;
    word-break: break-word;
  }

  .ingredients-wrapper {
    width: 100%;
    height: 100%;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
  }

  .ingredients-wrapper h2 {
    text-align: left;
  }

  .ingredients {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ingredients li {
    font-size: clamp(0.7rem, 1.15vw, 1.1rem);
    padding: 0.3rem 0.5rem;
    border-radius: 12px;
    background: var(--color-bg);
  }

  .instructions {
    font-family: var(--font-body);
    border-radius: 10px;
    padding: 4rem 2rem 4rem 2rem;
  }

  .instructions :global(p) {
    line-height: 1.8rem;
  }

  .instructions :global(ul, ol) {
    padding-left: 1rem;
  }

  .instructions :global(img) {
    display: block;
    height: auto;
    border-radius: 12px;
    max-width: 800px;
    max-height: 500px;
    object-fit: cover;
    margin-top: 5rem;
    justify-self: center;
    content-visibility: auto;
    decoding: async;
  }

  .instructions :global(p img + em) {
    display: block;
    text-align: center;
    margin-top: 0.5rem;
    margin-bottom: 5rem;
    font-style: italic;
  }

  @media (max-width: 576px) {
    section {
      padding: 5rem 0.6rem;
    }

    .instructions {
      padding: 1.5rem 1.1rem 1.5rem 1.1rem;
    }

    .instructions :global(p) {
      line-height: 1.5rem;
    }

    .instructions :global(img) {
      width: 100%;
      max-height: 400px;
      margin-top: 2rem;
    }

    .instructions :global(p img + em) {
      display: block;
      text-align: center;
      margin-top: 0.5rem;
      margin-bottom: 2rem;
      font-style: italic;
    }

    .left,
    .right {
      width: 100%;
      flex: none;
    }

    .hero-wrapper {
      flex-direction: column;
      gap: 1.5rem;
    }

    .hero-image {
      height: 220px;
    }

    .title-wrapper,
    .ingredients-wrapper {
      padding: 1rem;
    }

    .ingredients li {
      font-size: clamp(1rem, 2vw, 2rem);
    }
  }
</style>
