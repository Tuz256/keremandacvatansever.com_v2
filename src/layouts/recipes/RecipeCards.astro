---
import { getCollection } from "astro:content";
import Card from "../../components/Card.astro";
const allCookies = await getCollection("cookies");
---

<section id="Recipes">
  <div class="recipes-container">
    <div class="category">
      <div class="title-container">
        <div class="title-emoji-wrapper">🍪</div>
        <h2 class="title">Kurabiye</h2>
      </div>

      <div class="grid">
        {
          allCookies.map((cookie, index) => (
            <Card
              title={cookie.data.title}
              description={cookie.data.description}
              tags={cookie.data.tags}
              color={cookie.data.color}
              image={cookie.data.image}
              link={`/cookies/${cookie.id}`}
              delay={index * 0.1}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 7rem 2rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .recipes-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .title-container {
    display: flex;
  }

  .title-emoji-wrapper {
    padding-right: 1rem;
    font-size: 2rem;
    align-self: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(285px, 1fr));
    justify-content: center;
    gap: 1.5rem;

    animation: fadeInUp 0.8s ease forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 30%;
  }

  .card {
    display: block;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem;
    cursor: pointer;
    transition: all 0.3s ease;
    animation-delay: var(--delay);
  }

  .card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(127, 255, 212, 0.3);
    transform: translateY(-6px);
  }

  .card h3 {
    color: #fff;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .card p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    text-align: left;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
