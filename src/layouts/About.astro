---
import { Image } from "astro:assets";
import meImage from "../images/cift_monitor.png";
import { theme } from "../styles/style.js";
---

<section id="About">
  <div class="about-container">
    {/* Avatar */}
    <div class="avatar-wrapper">
      <div class="avatar-box">
        <Image src={meImage} alt="Avatar" class="avatar-img" />
      </div>
    </div>

    {/* Content */}
    <div class="content-box">
      <h2 class="heading">
        <span class="highlight-green">Doğa</span>'ya aşık,<br />
        <span class="highlight-blue">kod</span> yazan,<br />
        <span class="highlight-brand">mühendis</span> biri.
      </h2>

      <p class="description">
        Gömülü Sistemler ve IoT alanlarına odaklanmış Bilgisayar Mühendisliği
        mezunu. ESP32 ve STM32 platformları üzerindeki uygulamalı çalışmaları
        sayesinde C/C++, FreeRTOS ve donanım protokolleri (UART, SPI, MQTT)
        konularında yetkinlik sahibidir. Gömülü sistem çözümleri geliştirme
        konusunda tutkuludur. <br /><br />2017'den bu yana profesyonel dağ
        bisikletçisidir.
      </p>
    </div>
  </div>
</section>

<style
  define:vars={{
    headingFont: theme.fonts.heading,
    bodyFont: theme.fonts.body,
    brandColor: theme.colors.brandColor,
  }}
>
  #About {
    padding: 7rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    animation: fadeUp 0.8s ease forwards;
  }

  .avatar-wrapper {
    position: relative;
  }

  .avatar-box {
    width: 100%;
    padding-bottom: 100%;
    border-radius: 16px;
    border: 1px solid rgba(127, 255, 212, 0.15);
    position: relative;
    overflow: hidden;
  }

  .avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heading {
    font-family: var(--headingFont);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #fff;
    margin: 1.5rem 0;
    line-height: 1.2;
  }

  .highlight-green {
    color: #66db00;
  }
  .highlight-blue {
    color: #00cddb;
  }
  .highlight-brand {
    color: var(--brandColor);
  }

  .description {
    font-family: var(--bodyFont);
    font-size: 1rem;
    color: #ffffffcc;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    letter-spacing: 1px;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
