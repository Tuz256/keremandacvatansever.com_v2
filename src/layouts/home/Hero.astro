---

<section id="hero">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="hero-content">
    <h1 class="title-first">Kerem Andaç</h1>
    <h1 class="title-second">Vatansever</h1>
  </div>
</section>

<style>
  h1 {
    color: var(--color-text-title);
  }

  #hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
  }

  .blob-1 {
    top: 10%;
    left: 5%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #7fffd41f 0%, transparent 70%);
    animation: float1 8s ease-in-out infinite;
  }

  .blob-2 {
    bottom: 15%;
    right: 10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #6495ed1a 0%, transparent 70%);
    animation: float2 10s ease-in-out infinite;
  }

  .hero-content {
    text-align: center;
    max-width: 740px;
    z-index: 1;
  }

  .title-first {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.8;
    margin-bottom: 0rem;
    animation: fadeUp 0.8s 0.15s ease both;
  }

  .title-second {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.4;
    color: var(--color-brand);
    margin-bottom: 3rem;
    animation: fadeUp 0.8s 0.25s ease both;
  }

  @keyframes float1 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(20px, -30px) scale(1.05);
    }
  }

  @keyframes float2 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-25px, 20px) scale(1.03);
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
