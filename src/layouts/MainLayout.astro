---
// Global style import
import "../styles/global.css";

// Astro component imports
import MainHead from "./MainHead.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Default title", // text that display on tab
  description = "Default description", // for SEO meta description
  current = "Default current", // send current page name for "NavBar" to highlight it
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <MainHead {title} {description} />
  <body>
    <NavBar {current} />
    <main>
      <slot>Default Text </slot>
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    min-height: 100%;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
